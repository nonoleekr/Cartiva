# Optional: copy to apps/api/.env. Defaults work without this file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://cartiva:cartiva_local_only@127.0.0.1:5434/cartiva_dev
# Required only for the separate integration-test command. Never use your dev/prod DB.
TEST_DATABASE_URL=postgresql://cartiva_test:cartiva_test_only@127.0.0.1:5435/cartiva_test
# Generate a random secret locally with npm run auth:setup; never commit .env.
# BETTER_AUTH_SECRET=<at-least-32-random-characters>
APP_ORIGIN=http://127.0.0.1:5173
# Production: explicit HTTPS public origin, secret and DATABASE_URL required.
