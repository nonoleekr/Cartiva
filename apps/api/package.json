{
  "name": "@cartiva/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run tests/app.test.ts tests/env.test.ts tests/seed-safety.test.ts tests/auth-config.test.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "node --env-file-if-exists=.env ../../node_modules/prisma/build/index.js migrate deploy --config prisma7.config.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test:release": "tsx scripts/test-release.ts",
    "test:integration": "tsx --env-file-if-exists=.env scripts/test-integration.ts",
    "db:inspect": "tsx --env-file-if-exists=.env scripts/inspect-catalog.ts",
    "auth:setup": "tsx scripts/setup-auth.ts",
    "auth:grant-admin": "tsx --env-file-if-exists=.env scripts/grant-admin.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.26",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.26",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "auth": "1.7.26",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
